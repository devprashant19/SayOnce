{
  "name": "sayonce",
  "version": "0.1.0",
  "private": true,
  "description": "Say it once. Everyone gets their version.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tamper": "node --import tsx scripts/tamper-trail-test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "lab": "node --env-file=.env.local scripts/quality-lab.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "verify:all": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:live": "vitest run --config vitest.live.config.ts",
    "smoke:ai": "node --env-file=.env.local scripts/smoke-ai.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "visual": "node scripts/visual-check.mjs",
    "visual:states": "node scripts/visual-states.mjs",
    "verify:cached": "vitest run tests/cached-path-zero-ai.test.ts --reporter=verbose",
    "smoke:prod": "node scripts/smoke-playwright.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.44.2",
    "lucide-react": "^1.64.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
