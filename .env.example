# ---------------------------------------------------------------------------
# SayOnce environment. Copy to .env.local for development.
# Every value here is server-side only. Nothing in this file may ever be
# referenced from a client component or prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- AI (required from Phase 1) ---
# Free key from Google AI Studio: https://aistudio.google.com/apikey
# GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=

# One fixed model for the whole build so accuracy scores stay comparable.
#   gemini-2.5-flash  fast and cheap; the default, and enough for most cases
#   gemini-2.5-pro    better at exact source spans and tricky instructions
SAYONCE_MODEL=gemini-2.5-flash

# Pipeline temperature. Low, not zero: composing a natural message needs a
# little latitude. Raise only with a lab run to justify it.
SAYONCE_TEMPERATURE=0.2

# The grader must be repeatable. Leave this at 0 and do not change it
# mid-build, or two Quality Lab runs stop being comparable.
SAYONCE_GRADER_TEMPERATURE=0

# Reasoning budget in tokens for the 2.5 series. -1 is automatic, 0 is off.
# Set to the literal word "none" for a model outside the 2.5/3 series.
# Note: gemini-2.5-pro cannot turn thinking off and has a minimum of 128.
SAYONCE_THINKING_BUDGET=-1

# --- Database (required from Phase 2) ---
# Neon serverless Postgres connection string (pooled).
DATABASE_URL=

# --- Judge demo guard rails (required from Phase D) ---
# Master kill switch for live AI on visitor-typed text. off => cached samples only.
DEMO_LIVE_AI=on
# Live AI calls one visitor may make per demo session.
DEMO_SESSION_AI_CAP=10
# Live AI calls the whole deployment may make per UTC day.
DEMO_DAILY_AI_CAP=400
# HMAC secret used to sign demo session ids. 32+ random bytes, base64.
DEMO_SESSION_SECRET=

# --- Proof page ---
# Baseline minutes per update before SayOnce, measured in Phase 0. Used by
# the Voice Return meter and /proof. Must be a real measured number.
SAYONCE_BASELINE_MINUTES=
